# ============================================================
# Gemfile —— 网站的"零件采购清单"（Ruby 专用）
# ------------------------------------------------------------
# 【这个文件干什么用】
#   这个网站是用 Jekyll 生成的，Jekyll 又是用 Ruby 语言写的。
#   这份 Gemfile 相当于一张购物清单：告诉程序"要装哪些零件、
#   各装哪个版本"。构建网站时（本机预览或 GitHub 自动发布），
#   程序会照着这张清单去网上下载对应零件。
#
# 【运行效果】
#   清单装齐后，网站才能正常生成；少一个都可能导致构建失败。
#
# 【怎么改】
#   普通使用者一般不需要改。只有当您想把主题升级到新版本时，
#   才需要改下面 gem "jekyll-theme-chirpy" 后面的版本号。
# ============================================================

# frozen_string_literal: true
# 上面这行是给 Ruby 的一个声明：文件里的文字字符串"不许被程序改动"。
# 作用是从小处提升性能、也避免误改。保持原样即可，不要删。

# 告诉程序"零件到哪个仓库去下载"。rubygems.org 是 Ruby 官方零件仓库。
source "https://rubygems.org"

# 核心零件：Chirpy 主题，版本锁定在 7.6.0。
# 【可DIY修改】把 "7.6.0" 改成别的版本号可以升级/降级主题外观，
# 但升级后部分自定义样式可能需要跟着调整，建议先备份。
gem "jekyll-theme-chirpy", "7.6.0"

# 网页质量检查工具（检查死链接、图片缺失等问题）。
# ~> 5.0 的意思是"用 5.x 里的最新版，但不要跳到 6 这种大版本"。
# group: :test 表示它只在"测试模式"下安装，正常发布网站时不需要它。
gem "html-proofer", "~> 5.0", group: :test

# 时区相关零件：只给 Windows 系统或 JRuby 环境安装。
# 因为这两种环境下 Ruby 自带的时区数据不全，
# 不加会导致文章时间显示错乱。
platforms :windows, :jruby do
  # 时区规则数据，版本要求"至少 1、小于 3"。
  gem "tzinfo", ">= 1", "< 3"
  # 配套的时区数据包。
  gem "tzinfo-data"
end

# Windows 专用的"文件变化监听"零件：
# 本地预览时改动文件能立刻自动刷新，不用手动重开。
# ~> 0.2.0 表示用 0.2.x 系列的版本。
gem "wdm", "~> 0.2.0", :platforms => [:windows]
