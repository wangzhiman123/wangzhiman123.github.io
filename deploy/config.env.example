# ============================================================
#  config.env.example —— 阿里云 ECS 服务器部署配置（示例模板）
# ============================================================
#
#  【这个文件干什么用】
#    把网站从"GitHub 免费托管"改成"用自己的云服务器来发布"时，
#    服务器上的脚本需要知道：域名是什么、文件放哪里、证书邮箱填什么。
#    这些信息就写在这份配置里。
#
#    ⚠️ 这是一份"样板文件"，不要直接改它！
#       正确做法是在服务器上把它复制一份、改复制出来的那一份：
#
#        cd <源码目录>/deploy
#        cp config.env.example config.env      # 复制出一份真正的配置
#        vi config.env                          # 打开编辑，按下面说明改
#
#      这样以后更新代码时，您的真实配置不会被覆盖掉。
#
#  ⚠️ config.env 里含邮箱等信息，建议不要提交到公开仓库
#     （本目录的 .gitignore 已经把它排除，一般不会被误传）
#
#  【小白操作提示】
#    "vi" 是服务器上的一个文字编辑器。打开后按 i 键进入"可以打字"的状态，
#    用方向键移动光标，改完按 Esc 键，再输入 :wq 然后回车，即可保存退出。
# ============================================================

# ---------- 域名（必填，必须改）----------
# 注意：不要写 https:// 、也不要写结尾的斜杠，只写域名本身。
# 例如写 2019527.xyz，不要写 https://2019527.xyz/ 。
DOMAIN="2019527.xyz"                 # 请改成你的主域名
WWW_DOMAIN="www.2019527.xyz"         # 若不用 www 访问，可留空写成 ""

# ---------- 服务器上的目录（保持默认即可，一般不用改）----------
WEB_ROOT="/var/www/2019527.xyz"      # 对外网站目录（脚本会把它做成软链）
                                     # "软链"可以理解成一个快捷方式，
                                     # 网站在线访问的其实是这个快捷方式指向的内容。
RELEASES_DIR="/var/www/releases"     # 每个版本一个子目录，便于秒级回滚
                                     # 每次发布都会建一个新文件夹，出问题可一键切回旧版。
SRC_DIR="/opt/site/src"              # 源码所在目录（git clone 到这里）
                                     # 也就是您网站代码在服务器上的存放位置。

# ---------- 源码仓库（首次迁移时用）----------
# 服务器第一次拉取代码时，从这个网址下载。
REPO_URL="https://github.com/wangzhiman123/wangzhiman123.github.io.git"
REPO_BRANCH="main"                   # 要拉取的分支名，一般就是 main。

# ---------- HTTPS 证书邮箱（必填，必须改）----------
# Let's Encrypt（免费证书机构）用它给你发"证书快到期"提醒邮件。
# 填一个你常用的邮箱即可，不会公开显示。
LE_EMAIL="1320233415@qq.com"         # 请改成你的邮箱

# ---------- 其它（一般不用改）----------
WEB_USER="www-data"                  # Nginx 运行用户，Ubuntu 默认就是 www-data
                                     # （Nginx 是负责把网页发给访客的那个软件）
KEEP_RELEASES="5"                    # 回滚用：保留最近几个版本
                                     # 改成 5 就保留 5 个历史版本，更早的自动删掉以省磁盘。
VIEWS_CRON="0 3,9,15,21 * * *"       # 浏览量刷新时间（服务器本地时间=北京时间）
                                     # 这五个字段依次是：分 时 日 月 星期。
                                     # 0 3,9,15,21 * * * 表示每天 3点、9点、15点、21点 各跑一次。
                                     # 【可DIY修改】想改成每小时一次，写成 "0 * * * *"。
