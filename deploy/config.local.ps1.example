# ============================================================
#  config.local.ps1.example —— 本机（Windows）一键上传用的配置（模板）
# ============================================================
#
#  【这个文件干什么用】
#    在 Windows 上运行 deploy-aliyun.ps1 时，脚本需要知道：
#    连哪台服务器、用什么账号登录、私钥放在哪。
#    这些信息就写在这份配置里。
#
#    ⚠️ 这是一份"样板文件"，不要直接改它！
#       正确做法是复制一份再改：
#
#        Copy-Item config.local.ps1.example config.local.ps1
#        notepad config.local.ps1
#
#      第一条命令是"复制出真正要用的配置文件"，
#      第二条是用记事本打开它来修改。改完保存即可。
#
#  ⚠️ config.local.ps1 含服务器地址，不要提交到公开仓库
#     （本目录的 .gitignore 已经把它排除）
# ============================================================

# 服务器公网 IP（阿里云控制台能看到）
# 【可DIY修改】把引号里的 1.2.3.4 换成你服务器的真实公网 IP。
$ServerIp = "1.2.3.4"

# SSH 登录用户名（阿里云 ECS 默认是 root）
# SSH 可以理解为"从自己电脑安全地连到服务器上操作"的方式；
# 用户名就是告诉服务器"我是谁"。
# 【可DIY修改】一般保持 root 即可。
$SshUser  = "root"

# 私钥路径：登录服务器用的"钥匙文件"。
# 如果用密码登录，就改成空字符串 ""（运行时会提示输入密码）。
# $env:USERPROFILE 表示"当前用户的主目录"，一般不用改。
# 【可DIY修改】若你的钥匙文件名不是 id_ed25519，改成实际文件名。
$SshKey   = "$env:USERPROFILE\.ssh\id_ed25519"

# 服务器上的源码目录（必须与 config.env 里的 SRC_DIR 保持一致）
# 【可DIY修改】除非你在服务器上改了存放位置，否则保持默认。
$SrcDir   = "/opt/site/src"

# 本机仓库根目录（默认就是本文件的上一级，一般不用改）
# Resolve-Path = 把相对路径转成完整路径；
# $PSScriptRoot = 本文件所在的文件夹；
# ".." = 往上一级；整个意思是"本文件所在文件夹的上一级"，
# 也就是网站源码的根目录。
$RepoDir  = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
