@echo off
REM ============================================================
REM 【本文件是什么？】
REM  deploy-aliyun.bat —— 双击就能用的"一键上传发布"入口
REM
REM  一句话概括：这个 .bat 文件本身几乎不干活，
REM  它的唯一作用是"双击打开 → 启动旁边的 PowerShell 脚本"。
REM
REM  【为什么不能直接双击那个 .ps1 文件？】
REM  因为 Windows 出于安全考虑，默认不允许双击运行 PowerShell 脚本
REM  （担心有人发个脚本诱导您点击，然后干坏事）。
REM  所以惯例做法是配一个 .bat 文件当"门铃"：
REM  您双击 .bat（这个是被允许的），由它去敲门叫醒 .ps1 来干活。
REM
REM  给"代码小白"的操作步骤：
REM    1. 确认同目录下已经有 config.local.ps1（没有的话先复制模板并填好）
REM    2. 双击本文件
REM    3. 按提示输入服务器密码（如果配了密钥就不需要输）
REM    4. 看到"发布成功"就完成了，刷新网站即可看到效果
REM ============================================================

REM 关闭"命令回显"——不把每条命令本身也打印到屏幕上，输出更清爽。
chcp 65001 >nul
REM 把命令行的字符编码切换成 UTF-8（代号 65001）。
REM 【为什么需要？】不切的话，下面那些中文提示在黑色窗口里可能会变成乱码。
REM >nul 表示"这条命令的输出不用显示"，避免屏幕上多出一行编码信息。

setlocal
REM 开始一个"局部环境"。含义：本文件里设置的各种改动，
REM 在文件执行完毕后会自动撤销，不会残留在您的系统里造成影响。
REM 属于良好的编程习惯，照抄即可。

cd /d "%~dp0"
REM 把当前目录切换成"本文件所在的目录"。
REM 拆开读：
REM   %~dp0 = 本文件所在的完整路径（这是批处理里的固定写法）；
REM   cd /d = 切换目录，/d 表示"连盘符也一起切"（比如从 C 盘切到 D 盘也能生效）。
REM 【为什么必须先切目录？】这样后面找 deploy-aliyun.ps1 时，
REM 无论您从哪里启动这个文件，都能准确找到它旁边的那个脚本。

echo ============================================================
echo   一键上传并发布到阿里云 ECS
echo ============================================================
echo.
REM 在屏幕上打印一个简单的标题框，让您知道正在做什么、界面也更美观。
REM 最后的 echo. 单独一个点表示"输出一个空行"，用来分隔内容。

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0deploy-aliyun.ps1"
REM 【核心的一行】启动 PowerShell 去执行真正干活的脚本。
REM 各参数说明：
REM   -NoProfile            不要加载您电脑上的 PowerShell 个人配置。
REM                         好处：避免个人配置里的特殊设置干扰脚本运行，结果更稳定可复现。
REM   -ExecutionPolicy Bypass
REM                         本次运行临时"放行"脚本执行限制。
REM                         这就是解决"双击 ps1 被拦"的关键一步。
REM                         只对本次有效，不会降低您系统的整体安全性。
REM   -File "路径"          指定要运行哪个脚本文件。

set RC=%ERRORLEVEL%
REM 把上一条命令（也就是那个 PowerShell 脚本）的"退出状态码"记下来。
REM 约定：0 表示成功，非 0 表示出错了。
REM 记录下来是为了下面能判断到底成没成功，从而给出不同的提示。

echo.
REM 输出一个空行，把上面的输出和下面的结果提示分隔开，看起来更清爽。

if "%RC%"=="0" (
  echo [完成] 发布成功。
) else (
  echo [失败] 退出码 %RC% ，请查看上面的错误信息。
)
REM 根据结果码给出不同的结束提示：
REM   等于 0 → 显示"发布成功"，您可以放心去看网站了；
REM   不等于 0 → 显示失败以及具体的错误码。
REM   【错误码有什么用？】把它连同屏幕上面的报错内容一起截图，
REM   就能比较快地判断是哪一步出了问题（网络、密码、服务器环境等）。
echo.
pause
REM 打印一个空行，然后"暂停"。
REM 【为什么加 pause？】如果不加，任务一结束这个黑色窗口会立刻自动关闭，
REM 您根本来不及看上面的报错信息。加上它就会停在"请按任意键继续..."，
REM 让您有时间看完内容。
endlocal
REM 结束局部环境，与开头的 setlocal 呼应。照抄即可。
